# Copy these placeholders into ignored apps/web/.env.local and replace locally.
# Never commit real credentials. See docs/runbooks/github-oauth-setup.md.
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_GITHUB_ID=replace-with-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-oauth-client-secret
# Optional locally; required when using a Codespace's public origin.
# AUTH_URL=http://localhost:3000
